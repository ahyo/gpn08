# Aplikasi
APP_NAME="GPN 08 API"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Keamanan — WAJIB diganti di produksi
SECRET_KEY=ubah-dengan-kunci-acak-minimal-32-karakter
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Basis data PostgreSQL
DATABASE_URL=postgresql+psycopg://gpn08:gpn08@localhost:5432/gpn08

# CORS — asal frontend yang diizinkan, dipisah koma
CORS_ORIGINS=http://localhost:3000,https://<user>.github.io

# Seed data contoh saat startup (matikan di produksi)
SEED_ON_STARTUP=true
