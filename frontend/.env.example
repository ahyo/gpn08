# Base path saat di-host pada subdirektori (mis. GitHub Pages: /nama-repo).
# Kosongkan untuk domain khusus atau repo <user>.github.io.
NEXT_PUBLIC_BASE_PATH=

# true  -> mode demo, seluruh data dari localStorage (untuk GitHub Pages)
# false -> mode langsung, data dibaca/ditulis ke backend FastAPI
NEXT_PUBLIC_DEMO_MODE=true

# Alamat API FastAPI. Wajib diisi jika NEXT_PUBLIC_DEMO_MODE=false.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
